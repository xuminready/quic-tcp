[Unit]
Description=QUIC-TCP Rendezvous Server (Instance: %i)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/quic-tcp/rendezvous-server-%i.env
EnvironmentFile=-/etc/quic-tcp/rendezvous-server.env
ExecStart=/usr/local/bin/rendezvous-server ${PORT}
Restart=always
RestartSec=3s
LimitNOFILE=65536

# Sandboxing & Security
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
